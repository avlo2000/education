     "data": {
      "text/latex": [
       "$\\displaystyle - 2 g l m \\sin{\\left(\\theta{\\left(t \\right)} \\right)} + m \\left(h^{2} + l^{2}\\right) w^{2}{\\left(t \\right)}$"
      ],
      "text/plain": [
       "-2*g*l*m*sin(theta(t)) + m*(h**2 + l**2)*w(t)**2"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "from sympy.physics.mechanics import *\n",
    "import sympy as sp\n",
    "\n",
    "theta, w = dynamicsymbols('theta w')\n",
    "m, l, g, h, b = sp.symbols('m l g h b')\n",
    "L = m * (h ** 2 + l ** 2) * w ** 2 - 2 * m * g * l * sp.sin(theta)\n",
    "L"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "4705e7b3",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\left[\\begin{matrix}2 g l m \\cos{\\left(\\theta{\\left(t \\right)} \\right)}\\\\- 2 m \\left(h^{2} + l^{2}\\right) w{\\left(t \\right)}\\end{matrix}\\right]$"
      ],
      "text/plain": [
       "Matrix([\n",
       "[  2*g*l*m*cos(theta(t))],\n",
       "[-2*m*(h**2 + l**2)*w(t)]])"
      ]
     },
     "execution_count": 5,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "LM = LagrangesMethod(L, [theta, w])\n",
    "LM.form_lagranges_equations()"
   ]
  }
 ],
